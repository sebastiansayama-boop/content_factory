  "hard_constraints": [
    "Character remains a fictional adult male; do not infer or invent canonical age/eye shade/ethnicity from pixels.",
    "Avoid beautified plastic skin and oversharpened AI-looking detail.",
    "Do not default to head tilt, hand supporting head, direct camera gaze or half-smile.",
    "No invented EXIF, camera metadata or identity-verification claims.",
    "Photograph must have plausible gaze, hands, camera geometry and lighting.",
    "Do not treat a generated collage as independent multiple photographs."
  ],
  "anti_repetition": {
    "lookback_last_n": 3,
    "fields": [
      "head_direction",
      "gaze",
      "expression",
      "action",
      "hands",
      "framing",
      "camera_position",
      "capture_style"
    ],
    "maximum_matching_fields_consecutive": 3,
    "method": "operator_preflight; compare stored requests; if fewer than three history records exist, compare known recent images qualitatively",
    "not_auto_enforced": true
  },
